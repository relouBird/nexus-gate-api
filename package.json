{
  "name": "nexus-gate-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:lib:all && npm run build:app:all",
    "build:lib:all": "npm run build:lib:configuration && npm run build:lib:redis-cache && npm run build:lib:database && npm run build:lib:mailer",
    "build:lib:configuration": "nest build configuration",
    "build:lib:database": "npm run db:services:generate && nest build database",
    "build:lib:redis-cache": "nest build redis-cache",
    "build:lib:mailer": "nest build mailer",
    "build:app:all": "nest build api-gateway && nest build auth-service && nest build user-service && nest build configuration-service",
    "build:app:api-gateway": "nest build api-gateway",
    "build:app:auth-service": "nest build auth-service",
    "build:app:user-service": "nest build user-service",
    "build:app:configuration-service": "nest build configuration-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "db:services:generate": "prisma generate --config libs/database/prisma.config.ts",
    "db:services:format": "prisma format --schema=libs/database/prisma/schema.prisma",
    "db:services:studio": "prisma studio --config libs/database/prisma.config.ts",
    "db:services:migrate": "prisma migrate dev --name init --config libs/database/prisma.config.ts",
    "db:services:reset": "prisma migrate reset --config libs/database/prisma.config.ts",
    "db:forwarding:generate": "prisma generate --config apps/forwarding-service/prisma.config.ts",
    "db:forwarding:generate-copy": "node apps/forwarding-service/prisma.copy.ts",
    "db:forwarding:format": "prisma format --schema=apps/forwarding-service/prisma/schema.prisma",
    "db:forwarding:studio": "prisma studio --config apps/forwarding-service/prisma.config.ts",
    "db:forwarding:migrate": "prisma migrate dev --name init --config apps/forwarding-service/prisma.config.ts",
    "db:forwarding:reset": "prisma migrate reset --config apps/forwarding-service/prisma.config.ts",
    "start:auth-service": "nest start --watch auth-service",
    "start:user-service": "nest start --watch user-service",
    "start:configuration-service": "nest start --watch configuration-service",
    "start:forwarding-service": "concurrently -k -n \"Typescript,Node\" -p \"[{name}]\" -c \"blue,green\" \"tsc -p apps/forwarding-service/tsconfig.json --watch\" \"nodemon dist/apps/forwarding-service/main.js\"",
    "start:gateway": "nest start --watch api-gateway"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^7.8.0",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "geoip-country": "^5.0.202607010001",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^8.6.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/config": "^7.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/geoip-country": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.0.0",
    "concurrently": "^10.0.3",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@nexus/configuration(|/.*)$": "<rootDir>/libs/configuration/src/$1",
      "^@nexus/redis-cache(|/.*)$": "<rootDir>/libs/redis-cache/src/$1",
      "^@nexus/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@nexus/mailer(|/.*)$": "<rootDir>/libs/mailer/src/$1"
    }
  }
}
