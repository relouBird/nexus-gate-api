# Local environment migrated from apps/*/.env. This file is ignored by Git.

# /* _____API GATEWAY_____ */
## => URL WEB/DESKTOP
API_GATEWAY_FRONTEND_URL=localhost:9001

## => PROJECT PORT
API_GATEWAY_HTTP_PORT=9002
API_GATEWAY_AUTH_SERVICE_PORT=9003
API_GATEWAY_USER_SERVICE_PORT=9004
API_GATEWAY_CONFIGURATION_SERVICE_PORT=9005
API_GATEWAY_FORWARDING_SERVICE_PORT=9006


# /* _____AUTH SERVICE_____ */
## => URL WEB/DESKTOP
AUTH_SERVICE_FRONTEND_URL=localhost:9001

## => PROJECT PORT
AUTH_SERVICE_TCP_PORT=9003

## => DATABASE CREDENTIALS
AUTH_SERVICE_DATABASE_URL="mysql://root@localhost:3306/nexus_gate_database"
AUTH_SERVICE_DATABASE_USER="root"
AUTH_SERVICE_DATABASE_PASSWORD=""
AUTH_SERVICE_DATABASE_NAME="nexus_gate_database"
AUTH_SERVICE_DATABASE_HOST="localhost"
AUTH_SERVICE_DATABASE_PORT=3306

# /* _____USER SERVICE_____ */
## => URL WEB/DESKTOP
USER_SERVICE_FRONTEND_URL=localhost:9001

## => PROJECT PORT
USER_SERVICE_TCP_PORT=9004

## => DATABASE CREDENTIALS
USER_SERVICE_DATABASE_URL="mysql://root@localhost:3306/nexus_gate_database"
USER_SERVICE_DATABASE_USER="root"
USER_SERVICE_DATABASE_PASSWORD=""
USER_SERVICE_DATABASE_NAME="nexus_gate_database"
USER_SERVICE_DATABASE_HOST="localhost"
USER_SERVICE_DATABASE_PORT=3306

# /* _____CONFIGURATION SERVICE_____ */
## => PROJECT PORT
CONFIGURATION_SERVICE_TCP_PORT=9005

## => URL WEB/DESKTOP
CONFIGURATION_SERVICE_FRONTEND_URL=localhost:9001

## => DATABASE CREDENTIALS
CONFIGURATION_SERVICE_DATABASE_URL="mysql://root@localhost:3306/nexus_gate_database"
CONFIGURATION_SERVICE_DATABASE_USER="root"
CONFIGURATION_SERVICE_DATABASE_PASSWORD=""
CONFIGURATION_SERVICE_DATABASE_NAME="nexus_gate_database"
CONFIGURATION_SERVICE_DATABASE_HOST="localhost"
CONFIGURATION_SERVICE_DATABASE_PORT=3306

# /* _____FORWARDING SERVICE_____ */
## => PORT DU SERVICE
FORWARDING_SERVICE_HTTP_PORT=9006

## => DATABASE CREDENTIALS
FORWARDING_SERVICE_DATABASE_URL="mysql://root@localhost:3306/nexus_gate_database"
FORWARDING_SERVICE_DATABASE_USER="root"
FORWARDING_SERVICE_DATABASE_PASSWORD=""
FORWARDING_SERVICE_DATABASE_NAME="nexus_gate_database"
FORWARDING_SERVICE_DATABASE_HOST="localhost"
