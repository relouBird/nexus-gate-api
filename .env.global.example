# Template for the shared environment. Copy it to the environment-specific file.

# /* _____API GATEWAY_____ */
API_GATEWAY_HTTP_PORT=9002
API_GATEWAY_AUTH_SERVICE_PORT=9003
API_GATEWAY_USER_SERVICE_PORT=9004
API_GATEWAY_CONFIGURATION_SERVICE_PORT=9005
API_GATEWAY_FORWARDING_SERVICE_PORT=9006


# /* _____AUTH SERVICE_____ */
AUTH_SERVICE_TCP_PORT=9003

# /* _____USER SERVICE_____ */
USER_SERVICE_TCP_PORT=9004


# /* _____CONFIGURATION SERVICE_____ */
CONFIGURATION_SERVICE_TCP_PORT=9005

# /* _____FORWARDING SERVICE_____ */
FORWARDING_SERVICE_HTTP_PORT=9006

# /* _____SHARED SERVICES_____ */
## => DATABASE CREDENTIALS
SHARED_SERVICE_DATABASE_URL="mysql://root@localhost:3306/nexus_gate_database"
SHARED_SERVICE_DATABASE_USER="root"
SHARED_SERVICE_DATABASE_PASSWORD=""
SHARED_SERVICE_DATABASE_NAME="nexus_gate_database"
SHARED_SERVICE_DATABASE_HOST="localhost"
SHARED_SERVICE_DATABASE_PORT=3306

## => SERVICE REDIS
SHARED_REDIS_PORT=6379
SHARED_REDIS_HOST='127.0.0.1'

## => SERVICE DE MAILS
SHARED_SMTP_HOST="localhost"
SHARED_SMTP_PORT=1025
SHARED_SMTP_SECURE=false
SHARED_SMTP_USER=""
SHARED_SMTP_PASSWORD=""

## => JWT secret was present in the service files.
SHARED_JWT_SECRET=your_jwt_secret_here