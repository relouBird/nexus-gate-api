# Copy this file to .env.global and replace the example values.
# Never commit .env.global or put production secrets in this template.

# API gateway
API_GATEWAY_HTTP_PORT=9002
API_GATEWAY_AUTH_SERVICE_HOST=localhost
API_GATEWAY_AUTH_SERVICE_PORT=9003
API_GATEWAY_USER_SERVICE_HOST=localhost
API_GATEWAY_USER_SERVICE_PORT=9004
API_GATEWAY_CONFIGURATION_SERVICE_HOST=localhost
API_GATEWAY_CONFIGURATION_SERVICE_PORT=9005

# NestJS TCP services
AUTH_SERVICE_TCP_HOST=localhost
AUTH_SERVICE_TCP_PORT=9003
USER_SERVICE_TCP_HOST=localhost
USER_SERVICE_TCP_PORT=9004
CONFIGURATION_SERVICE_TCP_HOST=localhost
CONFIGURATION_SERVICE_TCP_PORT=9005

# Database connection settings (create these databases before starting the services)
AUTH_SERVICE_DATABASE_URL=mysql://root:change-me@localhost:3306/nexus_auth
AUTH_SERVICE_DATABASE_HOST=localhost
AUTH_SERVICE_DATABASE_PORT=3306
AUTH_SERVICE_DATABASE_NAME=nexus_auth
AUTH_SERVICE_DATABASE_USER=root
AUTH_SERVICE_DATABASE_PASSWORD=change-me

USER_SERVICE_DATABASE_URL=mysql://root:change-me@localhost:3306/nexus_user
USER_SERVICE_DATABASE_HOST=localhost
USER_SERVICE_DATABASE_PORT=3306
USER_SERVICE_DATABASE_NAME=nexus_user
USER_SERVICE_DATABASE_USER=root
USER_SERVICE_DATABASE_PASSWORD=change-me

CONFIGURATION_SERVICE_DATABASE_URL=mysql://root:change-me@localhost:3306/nexus_configuration
CONFIGURATION_SERVICE_DATABASE_HOST=localhost
CONFIGURATION_SERVICE_DATABASE_PORT=3306
CONFIGURATION_SERVICE_DATABASE_NAME=nexus_configuration
CONFIGURATION_SERVICE_DATABASE_USER=root
CONFIGURATION_SERVICE_DATABASE_PASSWORD=change-me

FORWARDING_SERVICE_HTTP_PORT=9006
FORWARDING_SERVICE_DATABASE_URL=mysql://root:change-me@localhost:3306/nexus_forwarding
FORWARDING_SERVICE_DATABASE_HOST=localhost
FORWARDING_SERVICE_DATABASE_PORT=3306
FORWARDING_SERVICE_DATABASE_NAME=nexus_forwarding
FORWARDING_SERVICE_DATABASE_USER=root
FORWARDING_SERVICE_DATABASE_PASSWORD=change-me

# Shared infrastructure
SHARED_REDIS_HOST=localhost
SHARED_REDIS_PORT=6379
SHARED_REDIS_PASSWORD=
SHARED_SMTP_HOST=localhost
SHARED_SMTP_PORT=587
SHARED_SMTP_FROM=noreply@nexus-gate.com
SHARED_JWT_SECRET=replace-with-a-random-secret
